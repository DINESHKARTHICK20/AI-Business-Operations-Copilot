# ============================================================
# AI Business Operations Copilot - Environment Configuration
# ============================================================

# Secret key for server-side cryptographic hashing & session generation
SECRET_KEY=bizops_prod_secret_key_change_in_production_2026

# Application environment ('development' | 'production')
ENVIRONMENT=development

# Cookie security flag (Set to 'true' in production with HTTPS)
SESSION_COOKIE_SECURE=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# SMTP Email Delivery Configuration (Sign Up OTP Verification)
# ============================================================
# SMTP Host (e.g., smtp.gmail.com, smtp.office365.com, smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Authentication Credentials
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Sender Identity
SMTP_FROM=noreply@aibizops.local
SMTP_FROM_NAME="AI Business Operations Copilot"

# Security flags
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
