# ============================================================
# AI Business Operations Copilot - Environment Configuration
# ============================================================

# Secret key for server-side cryptographic hashing & session generation
SECRET_KEY=bizops_prod_secret_key_change_in_production_2026

# Application environment ('development' | 'production')
ENVIRONMENT=development

# Cookie security flag (Set to 'true' in production with HTTPS)
SESSION_COOKIE_SECURE=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# Resend SMTP Configuration (Email OTP Registration)
# ============================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Enter your Resend API key below (starts with 're_')
# Get it at: https://resend.com/api-keys
SMTP_PASSWORD=
SMTP_FROM=onboarding@resend.dev
SMTP_FROM_NAME="AI Business Operations Copilot"
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_TIMEOUT=20

# ============================================================
# Resend Testing Mode (Without a Custom Domain)
# ============================================================
# Enter the Gmail address associated with your Resend account.
# In free testing mode without a custom domain, Resend requires onboarding@resend.dev
# to only send to your own registered account email.
# (Leave empty after verifying a custom domain to allow any recipient)
RESEND_TEST_RECIPIENT=your_resend_gmail_address@gmail.com
