# ============================================================
# Git Ignore - AI Business Operations Copilot
# ============================================================

# ─── 1. Environment Files & Local Secrets ───────────────────
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
backend/.env
backend/.env.*

# Explicitly allow committed example/template configurations
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# ─── 2. API Keys, Credentials & Local Secret Files ──────────
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*service[-_]account*.json
credentials.json
client_secret*.json
secrets.json
secrets.*.json
local_secrets.*
id_rsa*
id_ed25519*

# ─── 3. Node.js Dependencies & Tooling Caches ───────────────
node_modules/
.pnp
.pnp.js
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── 4. Python Virtual Environments ─────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/

# ─── 5. Python Bytecode & Cache Files ───────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ─── 6. Frontend Build Outputs & Tooling Caches ─────────────
dist/
dist-ssr/
build/
out/
.next/
.vite/
.eslintcache

# ─── 7. SQLite Databases, WAL, SHM & Dump Files ─────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/*.db-wal
backend/*.db-shm
*.bak
*.dump
*.sql.gz
backups/

# ─── 8. Log Files & Temporary Files ─────────────────────────
*.log
logs/
*.tmp
*.temp
.cache/
.temp/
tmp/
scratch/

# ─── 9. VS Code & Other IDE-Specific Files ──────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── 10. Operating System Artifacts ─────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── 11. Machine Learning Models & Artifacts ────────────────
# Ignore generic and temporary model dumps
*.pkl
*.joblib
*.h5
*.onnx

# Explicitly preserve required production-trained ML model files
!backend/models/*.pkl
!backend/models/*.joblib
!backend/models/**/*.pkl
!backend/models/**/*.joblib
